+
+describe("validateStructuralRules: ERC-8421 [BUDGET-010] per-entity budgets", () => {
+  const withLimit = (f: Frame, execution: bigint, target: `0x${string}` | null = null): Frame => ({
+    ...f,
+    target,
+    limits: { execution, state: 0n },
+  });
+  const arbitrary = (): SignatureEntry =>
+    ({ scheme: SIG_SCHEME.ARBITRARY, signer: "0x", msg: "0x", signature: "0x" }) as unknown as SignatureEntry;
+  const staked = (...addrs: string[]) => (entity: `0x${string}`) =>
+    addrs.map((a) => a.toLowerCase()).includes(entity.toLowerCase());
+
+  // A sender that is also its own payer: [only_verify -> sender, pay -> sender], two signature
+  // checks of 90k each, as a 2-of-n post-quantum guardian account would declare.
+  const senderPays = () => {
+    const frames = [
+      withLimit(verifyFrame(APPROVE_SCOPE.EXECUTION), 90_000n),
+      withLimit(verifyFrame(APPROVE_SCOPE.PAYMENT), 90_000n, SENDER),
+      userOpFrame(),
+    ];
+    const tx: FrameTransaction = { ...baseTx(frames), signatures: [arbitrary(), arbitrary()] };
+    return { frames, tx, prefix: recognizeValidationPrefix(frames, SENDER)! };
+  };
+
+  it("exports the ERC-8421 constants", () => {
+    expect(MAX_VERIFY_GAS_PER_ENTITY).toBe(100_000n);
+    expect(MAX_VERIFY_GAS_STAKED_ENTITY).toBe(1_000_000n);
+  });
+
+  it("rejects an unstaked sender whose own frames + signature cost exceed MAX_VERIFY_GAS_PER_ENTITY", () => {
+    const { tx, prefix } = senderPays();
+    expect(prefix).not.toBeNull();
+    const result = validateStructuralRules(tx, prefix);
+    expect(result.valid).toBe(false);
+    if (!result.valid) {
+      expect(result.reason).toMatch(/unstaked entity/);
+      expect(result.reason).toMatch(/MAX_VERIFY_GAS_PER_ENTITY/);
+      expect(result.reason).toMatch(/180200/); // 2 x 90k + 2 x 100 (ARBITRARY)
+    }
+  });
+
+  it("admits the same transaction when the sender is staked (MAX_VERIFY_GAS_STAKED_ENTITY)", () => {
+    const { tx, prefix } = senderPays();
+    expect(validateStructuralRules(tx, prefix, staked(SENDER))).toEqual({ valid: true });
+  });
+
+  it("still bounds a staked entity by MAX_VERIFY_GAS_STAKED_ENTITY", () => {
+    const frames = [
+      withLimit(verifyFrame(APPROVE_SCOPE.EXECUTION), 600_000n),
+      withLimit(verifyFrame(APPROVE_SCOPE.PAYMENT), 400_001n, SENDER),
+      userOpFrame(),
+    ];
+    const prefix = recognizeValidationPrefix(frames, SENDER)!;
+    const result = validateStructuralRules(baseTx(frames), prefix, staked(SENDER));
+    expect(result.valid).toBe(false);
+    if (!result.valid) {
+      expect(result.reason).toMatch(/staked entity/);
+      expect(result.reason).toMatch(/MAX_VERIFY_GAS_STAKED_ENTITY/);
+    }
+  });
+
+  it("tracks a separate paymaster's frames separately from the sender's", () => {
+    const frames = [
+      withLimit(verifyFrame(APPROVE_SCOPE.EXECUTION), 90_000n),
+      withLimit(verifyFrame(APPROVE_SCOPE.PAYMENT), 90_000n, PAYER),
+      userOpFrame(),
+    ];
+    const prefix = recognizeValidationPrefix(frames, SENDER)!;
+    // 90k each, two different unstaked entities: each within its own 100k budget.
+    expect(validateStructuralRules(baseTx(frames), prefix)).toEqual({ valid: true });
+  });
+
+  it("a staked paymaster does not raise an unstaked sender's budget", () => {
+    const frames = [
+      withLimit(verifyFrame(APPROVE_SCOPE.EXECUTION), MAX_VERIFY_GAS_PER_ENTITY + 1n),
+      withLimit(verifyFrame(APPROVE_SCOPE.PAYMENT), 1n, PAYER),
+      userOpFrame(),
+    ];
+    const prefix = recognizeValidationPrefix(frames, SENDER)!;
+    const result = validateStructuralRules(baseTx(frames), prefix, staked(PAYER));
+    expect(result.valid).toBe(false);
+    if (!result.valid) {
+      expect(result.reason).toMatch(/unstaked entity/);
+    }
+  });
+
+  it("counts a pre_verify frame toward the entity of the approving frame it precedes", () => {
+    const frames = [
+      withLimit(verifyFrame(APPROVE_SCOPE.EXECUTION), 1n),
+      withLimit(preVerifyFrame(PAYER), 60_000n, PAYER),
+      withLimit(verifyFrame(APPROVE_SCOPE.PAYMENT), 60_000n, PAYER),
+      userOpFrame(),
+    ];
+    const prefix = recognizeValidationPrefix(frames, SENDER)!;
+    expect(prefix).not.toBeNull();
+    const unstaked = validateStructuralRules(baseTx(frames), prefix);
+    expect(unstaked.valid).toBe(false);
+    if (!unstaked.valid) {
+      expect(unstaked.reason).toMatch(new RegExp(PAYER, "i"));
+    }
+    expect(validateStructuralRules(baseTx(frames), prefix, staked(PAYER))).toEqual({ valid: true });
+  });
+});
